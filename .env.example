# Copy to .env and fill in.

# Your login for the web app.
JAM_USERNAME=me
JAM_PASSWORD=change-me

# Signs login cookies. Generate one with: openssl rand -hex 32
# Changing it signs everyone out.
JAM_SECRET=

# Only set to true if you put the app behind HTTPS.
JAM_COOKIE_SECURE=false

# Music is fetched with yt-dlp. Put your YouTube cookies at ./data/cookies.txt to play
# as your (Premium) account; see the README. Override the location here if needed.
# JAM_COOKIES_FILE=/data/cookies.txt

# Disk space for downloaded songs (MB). Least recently played songs are removed first.
JAM_AUDIO_CACHE_MB=500

# Show the line being sung in the player tab's title (e.g. for waybar). Set to false to turn off.
JAM_LYRICS=true

# Telegram bot (optional): token from @BotFather. Leave empty for no bot.
JAM_TELEGRAM_TOKEN=

# How many upcoming songs to keep downloaded ahead of time, nearest first,
# and how many download at once.
JAM_PRELOAD_SONGS=20
JAM_PRELOAD_WORKERS=4
